{% extends 'base.html.twig' %}

{% block title %}Edit Product | Aceplus{% endblock %}

{% block body %}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Edit Product</h1>
        <p>Update the details of this product in your Aceplus inventory.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            {{ include('product/_form.html.twig', {
                button_label: 'Update Product'
            }) }}

        </div>
    </div>

    <div class="d-flex gap-2 mt-3">

        <a href="{{ path('admin_products_index') }}" class="btn btn-secondary">
            Back to Products
        </a>

        {{ include('product/_delete_form.html.twig') }}

    </div>

</div>

{% endblock %}
