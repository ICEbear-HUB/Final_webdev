
{{ form_start(form) }}

    {{ form_errors(form) }}

    {# PRODUCT NAME #}
    <div class="mb-3">
        {{ form_label(form.Name, 'Product Name', {
            'label_attr': {'class': 'form-label'}
        }) }}

        {{ form_widget(form.Name, {
            'attr': {
                'class': 'form-control',
                'placeholder': 'Enter product name'
            }
        }) }}

        {{ form_errors(form.Name) }}
    </div>

    {# DESCRIPTION #}
    <div class="mb-3">
        {{ form_label(form.description, 'Product Description', {
            'label_attr': {'class': 'form-label'}
        }) }}

        {{ form_widget(form.description, {
            'attr': {
                'class': 'form-control',
                'placeholder': 'Enter product description',
                'rows': 4
            }
        }) }}

        {{ form_errors(form.description) }}
    </div>

    {# PRICE #}
    <div class="mb-3">
        {{ form_label(form.price, 'Price (₱)', {
            'label_attr': {'class': 'form-label'}
        }) }}

        {{ form_widget(form.price, {
            'attr': {
                'class': 'form-control',
                'placeholder': 'Example: 99.99'
            }
        }) }}

        {{ form_errors(form.price) }}
    </div>

    {# STOCK #}
    <div class="mb-3">
        {{ form_label(form.stock, 'Available Stock', {
            'label_attr': {'class': 'form-label'}
        }) }}

        {{ form_widget(form.stock, {
            'attr': {
                'class': 'form-control',
                'placeholder': 'Enter available stock',
                'min': 0
            }
        }) }}

        {{ form_errors(form.stock) }}
    </div>

    {# IMAGE IMPORT FILE #}
    <div class="mb-3">
        {{ form_label(form.imageFile, 'Import Product Image', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.imageFile, {
            'attr': {
                'class': 'form-control',
                'accept': 'image/*'
            }
        }) }}
        <div class="form-text text-muted">
            Choose an image file from your computer (JPEG, PNG, WEBP, SVG max 5MB).
        </div>

        {{ form_errors(form.imageFile) }}

        {% if product is defined and product.image %}
            <div class="mt-2 p-2 rounded" style="background: rgba(255,255,255,0.05); display: inline-block;">
                <span class="d-block small text-muted mb-1">Current Image:</span>
                <img src="{{ asset(product.image) }}" alt="Current Product Image" style="max-height: 80px; max-width: 120px; object-fit: contain; border-radius: 6px;">
                <span class="d-block small text-muted mt-1">{{ product.image }}</span>
            </div>
        {% endif %}
    </div>

    {# OPTIONAL MANUAL PATH #}
    <div class="mb-3">
        <label class="form-label text-muted small" data-bs-toggle="collapse" data-bs-target="#manualPathCollapse" style="cursor: pointer;">
            <i class="bi bi-gear"></i> Advanced: Or specify image path manually
        </label>
        <div class="collapse" id="manualPathCollapse">
            {{ form_widget(form.image, {
                'attr': {
                    'class': 'form-control form-control-sm',
                    'placeholder': 'Example: images/Original.svg or uploads/products/my-image.png'
                }
            }) }}
            {{ form_errors(form.image) }}
        </div>
    </div>

    {# CATEGORY #}
    <div class="mb-3">
        {{ form_label(form.category, 'Product Category', {
            'label_attr': {'class': 'form-label'}
        }) }}

        {{ form_widget(form.category, {
            'attr': {'class': 'form-select'}
        }) }}

        {{ form_errors(form.category) }}
    </div>

    <button class="btn btn-success">
        {{ button_label|default('Save Product') }}
    </button>

{{ form_end(form) }}
