
{% extends 'base.html.twig' %}

{% block title %}Product Details | Aceplus{% endblock %}

{% block body %}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Product Details</h1>
        <p>View the complete information of this Aceplus product.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-bordered">
                <tbody>

                    <tr>
                        <th style="width: 25%;">Product ID</th>
                        <td>{{ product.id }}</td>
                    </tr>

                    <tr>
                        <th>Product Name</th>
                        <td>{{ product.Name }}</td>
                    </tr>

                    <tr>
                        <th>Category</th>
                        <td>{{ product.category.Name }}</td>
                    </tr>

                    <tr>
                        <th>Description</th>
                        <td>{{ product.description }}</td>
                    </tr>

                    <tr>
                        <th>Price</th>
                        <td>₱{{ product.price }}</td>
                    </tr>

                    <tr>
                        <th>Available Stock</th>
                        <td>{{ product.stock }}</td>
                    </tr>

                    <tr>
                        <th>Image Filename / Path</th>
                        <td>{{ product.image ?? 'No image uploaded' }}</td>
                    </tr>

                    <tr>
                        <th>Date Created</th>
                        <td>
                            {{ product.createdAt ? product.createdAt|date('F d, Y h:i A') : 'N/A' }}
                        </td>
                    </tr>

                </tbody>
            </table>

        </div>
    </div>

    <div class="d-flex gap-2 mt-3">

        <a href="{{ path('admin_products_index') }}" class="btn btn-secondary">
            Back to Products
        </a>

        <a href="{{ path('admin_products_edit', {'id': product.id}) }}"
           class="btn btn-warning">
            Edit Product
        </a>

        {{ include('product/_delete_form.html.twig') }}

    </div>

</div>

{% endblock %}
