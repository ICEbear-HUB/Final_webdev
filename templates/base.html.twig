
<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>{% block title %}Aceplus{% endblock %}</title>

        <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #f4f6f9;
            }

            /* ADMIN LAYOUT */
            .admin-layout {
                display: flex;
                min-height: 100vh;
            }

            /* SIDEBAR */
            .sidebar {
                width: 250px;
                min-width: 250px;
                background: #1f2937;
                color: white;
                padding: 20px;
            }

            .sidebar-header {
                margin-bottom: 30px;
            }

            .sidebar ul {
                list-style: none;
                padding: 0;
            }

            .sidebar li {
                margin-bottom: 15px;
            }

            .sidebar a {
                color: white;
                text-decoration: none;
            }

            .sidebar a:hover {
                color: #facc15;
            }

            /* MAIN CONTENT */
            .admin-content {
                flex: 1;
                min-width: 0;
                padding: 30px;
            }
        </style>
    </head>

    <body>
        {% block body %}{% endblock %}
    </body>
</html>
