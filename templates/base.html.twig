
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Aceplus{% endblock %}</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>

        :root {
            --primary: #a3e635;
            --primary-dark: #84cc16;
            --dark: #111827;
            --sidebar: #0b1220;
            --surface: #1f2937;
            --surface-light: #273449;
            --text: #f9fafb;
            --muted: #9ca3af;
            --border: #374151;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: var(--dark);
            color: var(--text);
        }

        a {
            text-decoration: none;
        }

        /* CUSTOMER NAVIGATION */

        .customer-navbar {
            background: rgba(11, 18, 32, 0.95);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .customer-navbar .navbar-brand {
            color: var(--primary);
            font-size: 23px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .customer-navbar .navbar-brand:hover {
            color: var(--primary-dark);
        }

        .customer-navbar .nav-link {
            color: #d1d5db;
            font-size: 14px;
            font-weight: 600;
        }

        .customer-navbar .nav-link:hover {
            color: var(--primary);
        }

        .customer-navbar .btn-orders {
            border: 1px solid var(--primary);
            color: var(--primary);
            font-weight: 600;
            border-radius: 8px;
            padding: 8px 14px;
        }

        .customer-navbar .btn-orders:hover {
            background: var(--primary);
            color: var(--dark);
        }

        /* MAIN LAYOUT */

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: 250px;
            min-width: 250px;
            background: var(--sidebar);
            color: white;
            padding: 25px 18px;
            border-right: 1px solid var(--border);
        }

        .sidebar-header {
            margin-bottom: 35px;
            padding: 0 10px;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            margin-bottom: 6px;
        }

        .sidebar-logo {
            width: 40px;
            height: 40px;
            object-fit: contain;
            filter: drop-shadow(0 0 12px rgba(163, 230, 53, 0.35));
        }

        .sidebar-header h2 {
            color: var(--primary);
            font-size: 24px;
            font-weight: 800;
            margin: 0;
            letter-spacing: -0.5px;
            line-height: 1.1;
        }

        .sidebar-header p {
            color: var(--muted);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin: 0;
            padding-left: 2px;
        }

        .sidebar nav ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar li {
            margin-bottom: 8px;
        }

        .sidebar a {
            display: block;
            color: #d1d5db;
            text-decoration: none;
            padding: 12px 15px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 500;
            transition: 0.2s ease;
        }

        .sidebar a:hover {
            background: #263449;
            color: var(--primary);
            transform: translateX(3px);
        }

        .sidebar a.btn-visit-home {
            background: rgba(163, 230, 53, 0.12);
            color: var(--primary);
            border: 1px dashed var(--primary);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 6px;
        }

        .sidebar a.btn-visit-home:hover {
            background: var(--primary);
            color: #0b1220;
            border-style: solid;
            transform: translateX(3px);
        }

        /* MAIN CONTENT */

        .admin-content,
        .main-content {
            flex: 1;
            min-width: 0;
            padding: 35px;
            background: var(--dark);
        }

        /* PAGE HEADERS */

        .page-header {
            margin-bottom: 30px;
        }

        .page-header h1 {
            font-size: 28px;
            font-weight: 800;
            color: white;
            margin-bottom: 8px;
        }

        .page-header p {
            color: var(--muted);
            font-size: 14px;
        }

        /* DASHBOARD CARDS */

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            color: white;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
        }

        .card h3,
        .card h4,
        .card h5 {
            color: white;
            font-weight: 700;
        }

        .card p {
            color: var(--muted);
        }

        /* TABLES */

        .table {
            --bs-table-bg: transparent;
            --bs-table-color: #e5e7eb;
            --bs-table-border-color: var(--border);
            margin-bottom: 0;
        }

        .table thead th {
            background: #263449;
            color: var(--primary);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 15px;
            border-color: var(--border);
        }

        .table tbody td {
            padding: 14px 15px;
            vertical-align: middle;
            border-color: var(--border);
        }

        .table tbody tr:hover {
            background: rgba(163, 230, 53, 0.04);
        }

        /* FORMS */

        .form-label {
            color: #e5e7eb;
            font-weight: 600;
            font-size: 13px;
        }

        .form-control,
        .form-select {
            background: #111827;
            border: 1px solid var(--border);
            color: white;
            border-radius: 8px;
            padding: 11px 13px;
        }

        .form-control:focus,
        .form-select:focus {
            background: #111827;
            color: white;
            border-color: var(--primary);
            box-shadow: 0 0 0 0.2rem rgba(163, 230, 53, 0.15);
        }

        .form-control::placeholder {
            color: #6b7280;
        }

        textarea.form-control {
            min-height: 100px;
        }

        /* BUTTONS */

        .btn-primary {
            background: var(--primary);
            border-color: var(--primary);
            color: #111827;
            font-weight: 700;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            border-color: var(--primary-dark);
            color: #111827;
        }

        .btn-success {
            background: #16a34a;
            border-color: #16a34a;
        }

        .btn-danger {
            background: #dc2626;
            border-color: #dc2626;
        }

        .btn-secondary {
            background: #374151;
            border-color: #4b5563;
        }

        /* ALERTS */

        .alert {
            border-radius: 10px;
        }

        /* BADGES */

        .badge {
            padding: 7px 10px;
            border-radius: 6px;
        }

        /* LINKS */

        .text-muted {
            color: var(--muted) !important;
        }

        
/* RESPONSIVE */
@media (max-width: 768px) {
    /* Stack sidebar above the main content */
    .admin-layout {
        flex-direction: column;
    }

    /* Mobile sidebar */
    .sidebar {
        width: 100%;
        min-width: 0;
        padding: 15px;
        position: relative;
    }

    .sidebar-header {
        margin-bottom: 12px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    /* Horizontally scrollable navigation */
    .sidebar nav {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .sidebar nav ul {
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
        width: max-content;
        min-width: 100%;
        padding: 0 0 8px;
        margin: 0;
    }

    .sidebar li {
        flex: 0 0 auto;
        margin-bottom: 0;
    }

    .sidebar a {
        display: block;
        white-space: nowrap;
        padding: 10px 13px;
        font-size: 13px;
    }

    /* Main content */
    .admin-content,
    .main-content {
        width: 100%;
        min-width: 0;
        padding: 20px 15px;
    }

    /* Page headings */
    .page-header h1 {
        font-size: 23px;
    }

    /* Responsive tables */
    .table-responsive {
        display: block;
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .table-responsive table {
        min-width: 650px;
    }

    /* Prevent buttons from exceeding the screen */
    .btn {
        max-width: 100%;
        white-space: normal;
    }
}

/* Smaller mobile screens */
@media (max-width: 480px) {
    .sidebar {
        padding: 12px;
    }

    .admin-content,
    .main-content {
        padding: 15px 10px;
    }

    .page-header h1 {
        font-size: 20px;
    }

    .sidebar a {
        font-size: 12px;
        padding: 9px 11px;
    }
}

        

    </style>

    {% block stylesheets %}{% endblock %}

</head>

<body>

    {# CUSTOMER NAVIGATION #}
    {% if app.user
        and 'ROLE_ADMIN' not in app.user.roles
        and 'ROLE_STAFF' not in app.user.roles
    %}
        <nav class="navbar navbar-expand-lg customer-navbar">
            <div class="container-fluid px-4">

                <a class="navbar-brand" href="{{ path('app_home') }}">
                    ACEPLUS
                </a>

                <div class="d-flex align-items-center gap-3">

                    <a href="{{ path('customer_profile') }}"
                       class="btn btn-outline-light btn-sm d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle text-primary"></i>
                        <span>{{ app.user.firstName }}</span>
                    </a>

                    <a href="{{ path('customer_orders_index') }}"
                       class="btn btn-orders btn-sm">
                        <i class="bi bi-bag"></i>
                        My Orders
                    </a>

                    <a href="{{ path('app_logout') }}"
                       class="btn btn-outline-danger btn-sm" title="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>

                </div>

            </div>
        </nav>
    {% endif %}

    {% block body %}{% endblock %}

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('click', function (event) {
            const toggleBtn = event.target.closest('[data-toggle-password]');
            if (!toggleBtn) return;

            const targetSelector = toggleBtn.getAttribute('data-toggle-password');
            const targetInput = targetSelector 
                ? document.querySelector(targetSelector)
                : toggleBtn.closest('.input-group')?.querySelector('input');

            if (!targetInput) return;

            const isPassword = targetInput.type === 'password';
            targetInput.type = isPassword ? 'text' : 'password';

            const icon = toggleBtn.querySelector('i');
            if (icon) {
                if (isPassword) {
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            }

            const label = isPassword ? 'Hide password' : 'Show password';
            toggleBtn.setAttribute('aria-label', label);
            toggleBtn.setAttribute('title', label);
        });
    </script>

    {% block javascripts %}{% endblock %}

</body>
</html>
