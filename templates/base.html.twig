
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Aceplus{% endblock %}</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>

        :root {
            --primary: #a3e635;
            --primary-dark: #84cc16;
            --dark: #111827;
            --sidebar: #0b1220;
            --surface: #1f2937;
            --surface-light: #273449;
            --text: #f9fafb;
            --muted: #9ca3af;
            --border: #374151;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: var(--dark);
            color: var(--text);
        }

        a {
            text-decoration: none;
        }

        /* MAIN LAYOUT */

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: 250px;
            min-width: 250px;
            background: var(--sidebar);
            color: white;
            padding: 25px 18px;
            border-right: 1px solid var(--border);
        }

        .sidebar-header {
            margin-bottom: 40px;
            padding: 0 10px;
        }

        .sidebar-header h2 {
            color: var(--primary);
            font-size: 27px;
            font-weight: 800;
            margin-bottom: 5px;
            letter-spacing: -1px;
        }

        .sidebar-header p {
            color: var(--muted);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .sidebar nav ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar li {
            margin-bottom: 8px;
        }

        .sidebar a {
            display: block;
            color: #d1d5db;
            text-decoration: none;
            padding: 12px 15px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 500;
            transition: 0.2s ease;
        }

        .sidebar a:hover {
            background: #263449;
            color: var(--primary);
            transform: translateX(3px);
        }

        /* MAIN CONTENT */

        .admin-content,
        .main-content {
            flex: 1;
            min-width: 0;
            padding: 35px;
            background: var(--dark);
        }

        /* PAGE HEADERS */

        .page-header {
            margin-bottom: 30px;
        }

        .page-header h1 {
            font-size: 28px;
            font-weight: 800;
            color: white;
            margin-bottom: 8px;
        }

        .page-header p {
            color: var(--muted);
            font-size: 14px;
        }

        /* DASHBOARD CARDS */

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            color: white;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
        }

        .card h3,
        .card h4,
        .card h5 {
            color: white;
            font-weight: 700;
        }

        .card p {
            color: var(--muted);
        }

        /* TABLES */

        .table {
            --bs-table-bg: transparent;
            --bs-table-color: #e5e7eb;
            --bs-table-border-color: var(--border);
            margin-bottom: 0;
        }

        .table thead th {
            background: #263449;
            color: var(--primary);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 15px;
            border-color: var(--border);
        }

        .table tbody td {
            padding: 14px 15px;
            vertical-align: middle;
            border-color: var(--border);
        }

        .table tbody tr:hover {
            background: rgba(163, 230, 53, 0.04);
        }

        /* FORMS */

        .form-label {
            color: #e5e7eb;
            font-weight: 600;
            font-size: 13px;
        }

        .form-control,
        .form-select {
            background: #111827;
            border: 1px solid var(--border);
            color: white;
            border-radius: 8px;
            padding: 11px 13px;
        }

        .form-control:focus,
        .form-select:focus {
            background: #111827;
            color: white;
            border-color: var(--primary);
            box-shadow: 0 0 0 0.2rem rgba(163, 230, 53, 0.15);
        }

        .form-control::placeholder {
            color: #6b7280;
        }

        textarea.form-control {
            min-height: 100px;
        }

        /* BUTTONS */

        .btn-primary {
            background: var(--primary);
            border-color: var(--primary);
            color: #111827;
            font-weight: 700;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            border-color: var(--primary-dark);
            color: #111827;
        }

        .btn-success {
            background: #16a34a;
            border-color: #16a34a;
        }

        .btn-danger {
            background: #dc2626;
            border-color: #dc2626;
        }

        .btn-secondary {
            background: #374151;
            border-color: #4b5563;
        }

        /* ALERTS */

        .alert {
            border-radius: 10px;
        }

        /* BADGES */

        .badge {
            padding: 7px 10px;
            border-radius: 6px;
        }

        /* LINKS */

        .text-muted {
            color: var(--muted) !important;
        }

        /* RESPONSIVE */

        @media (max-width: 768px) {

            .admin-layout {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                min-width: 100%;
                padding: 15px;
            }

            .sidebar-header {
                margin-bottom: 15px;
            }

            .sidebar nav ul {
                display: flex;
                flex-wrap: wrap;
                gap: 5px;
            }

            .sidebar li {
                margin-bottom: 0;
            }

            .sidebar a {
                padding: 9px 12px;
                font-size: 12px;
            }

            .admin-content,
            .main-content {
                padding: 20px 15px;
            }

            .page-header h1 {
                font-size: 23px;
            }

            .table-responsive {
                overflow-x: auto;
            }
        }

    </style>

    {% block stylesheets %}{% endblock %}

</head>

<body>

    {% block body %}{% endblock %}

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    {% block javascripts %}{% endblock %}

</body>
</html>
