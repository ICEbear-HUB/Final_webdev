
{% extends 'base.html.twig' %}

{% block title %}Aceplus Admin Dashboard{% endblock %}

{% block body %}

<div class="admin-layout">

    {% include 'partials/sidebar.html.twig' %}

    <main class="admin-content">

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h1 class="mb-1">Welcome to Aceplus Admin Dashboard!</h1>
                <p class="text-muted mb-0">
                    Manage your Aceplus Energy Drink website here.
                </p>
            </div>

            <a href="{{ path('admin_profile') }}"
               class="btn btn-outline-light d-flex align-items-center gap-2">
                <i class="bi bi-person-circle text-warning fs-5"></i>
                <span class="fw-semibold">
                    {{ app.user.firstName }} (Admin)
                </span>
            </a>
        </div>

        {# GENERAL WEBSITE STATISTICS #}
        <h3 class="mt-4 mb-3">Website Overview</h3>

        <div class="row">

            <div class="col-md-4 mb-3">
                <div class="card shadow p-3">
                    <h5>Total Users</h5>
                    <h2>{{ totalUsers }}</h2>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow p-3">
                    <h5>Total Products</h5>
                    <h2>{{ totalProducts }}</h2>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow p-3">
                    <h5>Total Categories</h5>
                    <h2>{{ totalCategories }}</h2>
                </div>
            </div>

        </div>

        {# INVENTORY OVERVIEW #}
        <h3 class="mt-4 mb-3">
            <i class="bi bi-box-seam"></i>
            Inventory Overview
        </h3>

        <div class="row">

            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card shadow p-3 h-100">
                    <h6>Total Stock Units</h6>
                    <h2 class="text-primary">
                        {{ totalStock|number_format }}
                    </h2>
                    <small class="text-muted">
                        Combined quantity of all products
                    </small>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card shadow p-3 h-100">
                    <h6>Products in Inventory</h6>
                    <h2>{{ totalProducts }}</h2>
                    <small class="text-muted">
                        Total registered products
                    </small>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card shadow p-3 h-100">
                    <h6>Low Stock</h6>
                    <h2 class="text-warning">
                        {{ lowStockCount }}
                    </h2>
                    <small class="text-muted">
                        1–{{ lowStockThreshold }} units remaining
                    </small>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card shadow p-3 h-100">
                    <h6>Out of Stock</h6>
                    <h2 class="text-danger">
                        {{ outOfStockCount }}
                    </h2>
                    <small class="text-muted">
                        Products with zero stock
                    </small>
                </div>
            </div>

        </div>

        {# LOW STOCK PRODUCTS TABLE #}
        <div class="card shadow mt-3 mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle text-warning"></i>
                    Low Stock Products
                </h5>
                <span class="badge bg-warning text-dark">
                    {{ lowStockCount }} Products
                </span>
            </div>

            <div class="card-body">

                {% if lowStockProducts is empty %}

                    <div class="alert alert-success mb-0">
                        <i class="bi bi-check-circle"></i>
                        All products have sufficient stock.
                    </div>

                {% else %}

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>Category</th>
                                    <th>Available Stock</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for product in lowStockProducts %}
                                    <tr>
                                        <td>{{ product.name }}</td>

                                        <td>
                                            {{ product.category
                                                ? product.category.name
                                                : 'Uncategorized' }}
                                        </td>

                                        <td>
                                            <strong class="text-warning">
                                                {{ product.stock }}
                                            </strong>
                                        </td>

                                        <td>
                                            <span class="badge bg-warning text-dark">
                                                Low Stock
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>

                        </table>
                    </div>

                {% endif %}

            </div>
        </div>

        {# OUT OF STOCK PRODUCTS TABLE #}
        <div class="card shadow mt-3 mb-4">

            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-x-circle text-danger"></i>
                    Out-of-Stock Products
                </h5>
            </div>

            <div class="card-body">

                {% if outOfStockProducts is empty %}

                    <div class="alert alert-success mb-0">
                        All products currently have available stock.
                    </div>

                {% else %}

                    <div class="table-responsive">
                        <table class="table table-hover">

                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>Category</th>
                                    <th>Available Stock</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for product in outOfStockProducts %}
                                    <tr>
                                        <td>{{ product.name }}</td>

                                        <td>
                                            {{ product.category
                                                ? product.category.name
                                                : 'Uncategorized' }}
                                        </td>

                                        <td>
                                            <strong class="text-danger">
                                                {{ product.stock }}
                                            </strong>
                                        </td>

                                        <td>
                                            <span class="badge bg-danger">
                                                Out of Stock
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>

                        </table>
                    </div>

                {% endif %}

            </div>
        </div>

        {# ORDER STATISTICS #}
        <h3 class="mt-4 mb-3">Order Statistics</h3>

        <div class="row">

            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card shadow p-3">
                    <h6>Total Orders</h6>
                    <h2>{{ totalOrders }}</h2>
                </div>
            </div>

            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card shadow p-3">
                    <h6>Pending Orders</h6>
                    <h2 class="text-warning">{{ pendingOrders }}</h2>
                </div>
            </div>

            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card shadow p-3">
                    <h6>Processing Orders</h6>
                    <h2 class="text-info">{{ processingOrders }}</h2>
                </div>
            </div>

            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card shadow p-3">
                    <h6>Completed Orders</h6>
                    <h2 class="text-success">{{ completedOrders }}</h2>
                </div>
            </div>

            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card shadow p-3">
                    <h6>Cancelled Orders</h6>
                    <h2 class="text-danger">{{ cancelledOrders }}</h2>
                </div>
            </div>

            <div class="col-md-8 col-lg-6 mb-3">
                <div class="card shadow p-3">
                    <h6>Total Sales (Completed Orders)</h6>
                    <h2 style="color: #a3e635;">
                        ₱{{ totalSales|number_format(2) }}
                    </h2>
                </div>
            </div>

        </div>

        <div class="mt-3">
            <a href="{{ path('manage_orders_index') }}"
               class="btn btn-primary">
                <i class="bi bi-bag"></i>
                Manage Customer Orders
            </a>
        </div>

    </main>

</div>

{% endblock %}
