{% extends 'base.html.twig' %}

{% block title %}Admin Profile - Aceplus{% endblock %}

{% block body %}
<div class="admin-layout">

    {% include 'partials/sidebar.html.twig' %}

    <main class="admin-content">

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h1 class="h3 fw-bold mb-1">Admin Profile</h1>
                <p class="text-muted mb-0">Manage your administrator account information and credentials.</p>
            </div>
            <a href="{{ path('app_admin') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-speedometer2"></i> Back to Dashboard
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-check-circle-fill"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}

        <div class="row g-4">
            {# PROFILE SUMMARY CARD #}
            <div class="col-lg-4">
                <div class="card shadow p-4 text-center h-100" style="background: var(--surface); border: 1px solid var(--border); border-radius: 14px;">
                    <div class="mb-3">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 86px; height: 86px; background: rgba(163, 230, 53, 0.15); border: 2px solid var(--primary);">
                            <i class="bi bi-person-fill text-warning" style="font-size: 42px;"></i>
                        </div>
                    </div>

                    <h4 class="fw-bold mb-1" style="color: var(--text);">{{ user.firstName }} {{ user.lastName }}</h4>
                    <span class="badge mb-3 d-inline-block px-3 py-2" style="background: rgba(255, 193, 7, 0.15); color: #ffc107; font-size: 12px; border: 1px solid rgba(255, 193, 7, 0.4);">
                        <i class="bi bi-shield-lock-fill me-1"></i> System Administrator
                    </span>

                    <hr style="border-color: var(--border);">

                    <div class="text-start small">
                        <div class="mb-2">
                            <span class="text-muted d-block">Email Address</span>
                            <span class="fw-semibold text-light">{{ user.email }}</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted d-block">Account Status</span>
                            <span class="badge bg-success">Active</span>
                        </div>
                        <div>
                            <span class="text-muted d-block">Role Access</span>
                            <span class="text-light">Full Administrative Permissions</span>
                        </div>
                    </div>

                    <div class="mt-4 pt-2">
                        <a href="{{ path('admin_change_password') }}" class="btn btn-outline-warning w-100 btn-sm">
                            <i class="bi bi-key-fill me-1"></i> Change Password
                        </a>
                    </div>
                </div>
            </div>

            {# EDIT PROFILE FORM #}
            <div class="col-lg-8">
                <div class="card shadow p-4" style="background: var(--surface); border: 1px solid var(--border); border-radius: 14px;">
                    <h5 class="fw-bold mb-4" style="color: var(--primary);">
                        <i class="bi bi-pencil-square me-2"></i>Edit Account Information
                    </h5>

                    {{ form_start(form) }}
                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_label(form.firstName, 'First Name', {'label_attr': {'class': 'form-label text-muted small fw-semibold'}}) }}
                                {{ form_widget(form.firstName, {'attr': {'class': 'form-control bg-dark border-secondary text-white'}}) }}
                                {{ form_errors(form.firstName) }}
                            </div>

                            <div class="col-md-6">
                                {{ form_label(form.lastName, 'Last Name', {'label_attr': {'class': 'form-label text-muted small fw-semibold'}}) }}
                                {{ form_widget(form.lastName, {'attr': {'class': 'form-control bg-dark border-secondary text-white'}}) }}
                                {{ form_errors(form.lastName) }}
                            </div>

                            <div class="col-12">
                                {{ form_label(form.phone, 'Phone Number', {'label_attr': {'class': 'form-label text-muted small fw-semibold'}}) }}
                                {{ form_widget(form.phone, {'attr': {'class': 'form-control bg-dark border-secondary text-white', 'placeholder': 'Optional: 09123456789'}}) }}
                                {{ form_errors(form.phone) }}
                            </div>

                            <div class="col-12">
                                {{ form_label(form.address, 'Address / Office Location', {'label_attr': {'class': 'form-label text-muted small fw-semibold'}}) }}
                                {{ form_widget(form.address, {'attr': {'class': 'form-control bg-dark border-secondary text-white', 'rows': 3, 'placeholder': 'Optional address'}}) }}
                                {{ form_errors(form.address) }}
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4 flex-wrap">
                            <button type="submit" class="btn fw-bold px-4" style="background: var(--primary); color: #0b1220;">
                                <i class="bi bi-check2-circle me-1"></i> Save Changes
                            </button>
                            <a href="{{ path('admin_change_password') }}" class="btn btn-outline-warning">
                                <i class="bi bi-shield-lock me-1"></i> Change Password
                            </a>
                            <a href="{{ path('app_admin') }}" class="btn btn-secondary">
                                Cancel
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>

    </main>

</div>
{% endblock %}
