{% extends 'base.html.twig' %}

{% block title %}Change Admin Password - Aceplus{% endblock %}

{% block body %}
<div class="admin-layout">

    {% include 'partials/sidebar.html.twig' %}

    <main class="admin-content">

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h1 class="h3 fw-bold mb-1">Change Admin Password</h1>
                <p class="text-muted mb-0">Ensure your administrative account remains protected with a strong password.</p>
            </div>
            <a href="{{ path('admin_profile') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Profile
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-check-circle-fill"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}

        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card shadow p-4 p-sm-5" style="background: var(--surface); border: 1px solid var(--border); border-radius: 14px;">

                    <h5 class="fw-bold mb-3" style="color: #ffc107;">
                        <i class="bi bi-shield-lock-fill me-2"></i>Update Security Credentials
                    </h5>

                    <form method="POST">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_change_password') }}">

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-semibold">Current Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-lock"></i></span>
                                <input type="password" name="current_password" class="form-control bg-dark border-secondary text-white" required autocomplete="current-password" placeholder="Enter current password">
                                <button type="button" class="btn btn-outline-secondary border-secondary bg-dark text-muted" data-toggle-password aria-label="Show password" title="Show password">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-semibold">New Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-key"></i></span>
                                <input type="password" name="new_password" class="form-control bg-dark border-secondary text-white" minlength="8" required autocomplete="new-password" placeholder="Minimum 8 characters">
                                <button type="button" class="btn btn-outline-secondary border-secondary bg-dark text-muted" data-toggle-password aria-label="Show password" title="Show password">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <div class="form-text text-muted">Use at least 8 characters with a mix of letters and numbers.</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-muted small fw-semibold">Confirm New Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-shield-check"></i></span>
                                <input type="password" name="confirm_password" class="form-control bg-dark border-secondary text-white" minlength="8" required autocomplete="new-password" placeholder="Re-type new password">
                                <button type="button" class="btn btn-outline-secondary border-secondary bg-dark text-muted" data-toggle-password aria-label="Show password" title="Show password">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-warning fw-bold px-4">
                                <i class="bi bi-check2-circle me-1"></i> Update Password
                            </button>
                            <a href="{{ path('admin_profile') }}" class="btn btn-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </main>

</div>
{% endblock %}
