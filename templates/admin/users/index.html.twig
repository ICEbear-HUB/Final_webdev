
{% extends 'base.html.twig' %}

{% block title %}User Management | Aceplus{% endblock %}

{% block body %}

<div class="admin-layout">

    {% include 'partials/sidebar.html.twig' %}

    <main class="admin-content">

        <div class="container-fluid">

            <h1 class="mb-2">User Management</h1>
            <p class="text-muted">
                Manage registered users and staff accounts.
            </p>

            {# Flash Messages #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <div class="card shadow p-4 mt-4">

                <div class="d-flex flex-wrap justify-content-between
                            align-items-center gap-3 mb-3">

                    <h4 class="mb-0">Registered Users</h4>

                    <div>
                        <span class="badge bg-primary">
                            Total: {{ users|length }}
                        </span>

                        <a href="{{ path('admin_users_new') }}"
                           class="btn btn-primary btn-sm ms-2">
                            <i class="bi bi-person-plus"></i>
                            Add New User
                        </a>
                    </div>

                </div>

                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Email</th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Roles</th>
                                <th>Date Created</th>
                                <th>Status</th>
                                <th style="min-width: 260px;">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            {% for user in users %}

                                <tr>

                                    <td>{{ user.id }}</td>

                                    <td>{{ user.email }}</td>

                                    <td>{{ user.firstName }}</td>

                                    <td>{{ user.lastName }}</td>

                                    <td>
                                        {% for role in user.roles %}

                                            {% if role == 'ROLE_ADMIN' %}
                                                <span class="badge bg-danger">
                                                    Admin
                                                </span>
                                            {% elseif role == 'ROLE_STAFF' %}
                                                <span class="badge bg-warning text-dark">
                                                    Staff
                                                </span>
                                            {% elseif role == 'ROLE_USER' %}
                                                <span class="badge bg-info text-dark">
                                                    Customer
                                                </span>
                                            {% else %}
                                                <span class="badge bg-secondary">
                                                    {{ role }}
                                                </span>
                                            {% endif %}

                                        {% endfor %}
                                    </td>

                                    <td>
                                        {% if user.createdAt %}
                                            {{ user.createdAt|date('M d, Y') }}
                                        {% else %}
                                            <span class="text-muted">N/A</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {% if user.isActive %}
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        {% else %}
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        {% endif %}
                                    </td>

                                    <td>

                                        {% if 'ROLE_ADMIN' not in user.roles %}

                                            <div class="d-flex flex-wrap gap-1">

                                                {# View User #}
                                                <a href="{{ path('admin_users_show', {id: user.id}) }}"
                                                   class="btn btn-info btn-sm">
                                                    <i class="bi bi-eye"></i>
                                                    View
                                                </a>

                                                {# Edit User #}
                                                <a href="{{ path('admin_users_edit', {id: user.id}) }}"
                                                   class="btn btn-warning btn-sm">
                                                    <i class="bi bi-pencil"></i>
                                                    Edit
                                                </a>

                                                {# Enable / Disable User #}
                                                <form method="POST"
                                                      action="{{ path('admin_users_toggle_status', {id: user.id}) }}"
                                                      onsubmit="return confirm('Are you sure you want to change this account status?');">

                                                    <input type="hidden"
                                                           name="_token"
                                                           value="{{ csrf_token('toggle_user_' ~ user.id) }}">

                                                    {% if user.isActive %}

                                                        <button type="submit"
                                                                class="btn btn-secondary btn-sm">
                                                            <i class="bi bi-person-slash"></i>
                                                            Disable
                                                        </button>

                                                    {% else %}

                                                        <button type="submit"
                                                                class="btn btn-success btn-sm">
                                                            <i class="bi bi-person-check"></i>
                                                            Enable
                                                        </button>

                                                    {% endif %}

                                                </form>

                                                {# Delete User #}
                                                <form method="POST"
                                                      action="{{ path('admin_users_delete', {id: user.id}) }}"
                                                      onsubmit="return confirm('Are you sure you want to permanently delete this account? This action cannot be undone.');">

                                                    <input type="hidden"
                                                           name="_token"
                                                           value="{{ csrf_token('delete_user_' ~ user.id) }}">

                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm">
                                                        <i class="bi bi-trash"></i>
                                                        Delete
                                                    </button>

                                                </form>

                                            </div>

                                        {% else %}

                                            <span class="text-muted">
                                                <i class="bi bi-shield-lock"></i>
                                                Protected Account
                                            </span>

                                        {% endif %}

                                    </td>

                                </tr>

                            {% else %}

                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        No users found.
                                    </td>
                                </tr>

                            {% endfor %}

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </main>

</div>

{% endblock %}
