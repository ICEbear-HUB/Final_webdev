
{% extends 'base.html.twig' %}

{% block title %}Staff Dashboard | Aceplus{% endblock %}

{% block body %}

<div class="admin-layout">

    {% include 'partials/staff_sidebar.html.twig' %}

    <main class="admin-content">

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h1 class="mb-1">Welcome to Aceplus Staff Dashboard!</h1>
                <p class="text-muted mb-0">Manage your assigned tasks and monitor product inventory.</p>
            </div>
            <a href="{{ path('staff_profile') }}" class="btn btn-outline-light d-flex align-items-center gap-2">
                <i class="bi bi-person-circle text-info fs-5"></i>
                <span class="fw-semibold">{{ app.user.firstName }} (Staff)</span>
            </a>
        </div>

        <div class="card shadow p-4 mt-4">
            <h4>Staff Portal</h4>
            <p>
                Welcome, {{ app.user.firstName }}!
                You are logged in as a Staff member.
            </p>
        </div>

        {# EXISTING INVENTORY STATISTICS #}
        <h3 class="mt-4 mb-3">Inventory Statistics</h3>

        <div class="row">

            <div class="col-md-6 mb-3">
                <div class="card shadow p-4">
                    <h5>Total Products</h5>
                    <h2>{{ totalProducts }}</h2>

                    <a href="{{ path('staff_products') }}">
                        View Products
                    </a>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="card shadow p-4">
                    <h5>Low Stock Products</h5>
                    <h2 class="text-warning">{{ lowStockProducts }}</h2>

                    <p class="text-muted">
                        Products with 10 or fewer units remaining.
                    </p>
                </div>
            </div>

        </div>

        {# ORDER STATISTICS #}
        <h3 class="mt-4 mb-3">Order Statistics</h3>

        <div class="row">

            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card shadow p-3">
                    <h6>Total Orders</h6>
                    <h2>{{ totalOrders }}</h2>
                </div>
            </div>

            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card shadow p-3">
                    <h6>Pending Orders</h6>
                    <h2 class="text-warning">{{ pendingOrders }}</h2>
                </div>
            </div>

            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card shadow p-3">
                    <h6>Processing Orders</h6>
                    <h2 class="text-info">{{ processingOrders }}</h2>
                </div>
            </div>

            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card shadow p-3">
                    <h6>Completed Orders</h6>
                    <h2 class="text-success">{{ completedOrders }}</h2>
                </div>
            </div>

            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card shadow p-3">
                    <h6>Cancelled Orders</h6>
                    <h2 class="text-danger">{{ cancelledOrders }}</h2>
                </div>
            </div>

            <div class="col-md-8 col-lg-6 mb-3">
                <div class="card shadow p-3">
                    <h6>Total Sales (Completed Orders)</h6>
                    <h2 style="color: #a3e635;">
                        ₱{{ totalSales|number_format(2) }}
                    </h2>
                </div>
            </div>

        </div>

        <div class="mt-3">
            <a href="{{ path('manage_orders_index') }}"
               class="btn btn-primary">
                <i class="bi bi-bag"></i>
                Manage Customer Orders
            </a>
        </div>

    </main>

</div>

{% endblock %}
