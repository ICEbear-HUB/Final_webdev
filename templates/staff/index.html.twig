
{% extends 'base.html.twig' %}

{% block title %}Staff Product Inventory | Aceplus{% endblock %}

{% block body %}

<div class="admin-layout">

    {% include 'partials/staff_sidebar.html.twig' %}

    <main class="admin-content">

        <h1>Product Inventory</h1>

        <p class="text-muted">
            View product information and monitor available stock.
        </p>

        <div class="card shadow p-4 mt-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Available Products</h4>
                <span class="badge bg-primary">
                    Total: {{ products|length }}
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Available Stock</th>
                            <th>Stock Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for product in products %}

                            <tr>
                                <td>{{ product.id }}</td>

                                <td>{{ product.Name }}</td>

                                <td>
                                    {{ product.category.Name ?? 'Uncategorized' }}
                                </td>

                                <td>
                                    ₱{{ product.price|number_format(2, '.', ',') }}
                                </td>

                                <td>{{ product.stock }}</td>

                                <td>
                                    {% if product.stock <= 10 %}
                                        <span class="badge bg-danger">
                                            Low Stock
                                        </span>
                                    {% elseif product.stock <= 30 %}
                                        <span class="badge bg-warning text-dark">
                                            Limited Stock
                                        </span>
                                    {% else %}
                                        <span class="badge bg-success">
                                            In Stock
                                        </span>
                                    {% endif %}
                                </td>
                            </tr>

                        {% else %}

                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    No products available.
                                </td>
                            </tr>

                        {% endfor %}

                    </tbody>

                </table>
            </div>

            <div class="mt-3">
                <a href="{{ path('app_staff') }}" class="btn btn-secondary">
                    Back to Dashboard
                </a>
            </div>

        </div>

    </main>

</div>

{% endblock %}
