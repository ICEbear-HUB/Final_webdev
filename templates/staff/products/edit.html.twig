
{% extends 'base.html.twig' %}

{% block title %}Edit Product | Aceplus{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 750px;">
        <h2 class="mb-2">Edit Product</h2>
        <p class="text-muted">
            Update your product information.
        </p>

        {% include 'product/_form.html.twig' with {
            button_label: 'Update Product'
        } %}

        <a href="{{ path('staff_products') }}"
           class="btn btn-secondary mt-3">
            Back to Product Inventory
        </a>
    </div>
</div>
{% endblock %}
