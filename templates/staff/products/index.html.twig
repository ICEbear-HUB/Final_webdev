
{% extends 'base.html.twig' %}

{% block title %}Staff Product Inventory | Aceplus{% endblock %}

{% block body %}

<div class="admin-layout">

    {% include 'partials/staff_sidebar.html.twig' %}

    <main class="admin-content">

        <h1>Product Inventory</h1>

        <p class="text-muted">
            View shared products and manage products you created.
        </p>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <div class="card shadow p-4 mt-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Available Products</h4>

                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-primary">
                        Total: {{ products|length }}
                    </span>

                    <a href="{{ path('staff_products_new') }}"
                       class="btn btn-success">
                        + Add Product
                    </a>
                </div>
            </div>

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Stock Status</th>
                            <th>Ownership</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for product in products %}

                            {% set isOwner = product.createdBy and product.createdBy.id == app.user.id %}

                            <tr>
                                <td>{{ product.id }}</td>

                                <td>{{ product.Name }}</td>

                                <td>
                                    {{ product.category.Name ?? 'Uncategorized' }}
                                </td>

                                <td>
                                    ₱{{ product.price|number_format(2, '.', ',') }}
                                </td>

                                <td>
                                    <strong>{{ product.stock }}</strong>
                                </td>

                                <td>
                                    {% if product.stock <= 10 %}
                                        <span class="badge bg-danger">Low Stock</span>
                                    {% elseif product.stock <= 30 %}
                                        <span class="badge bg-warning text-dark">Limited Stock</span>
                                    {% else %}
                                        <span class="badge bg-success">In Stock</span>
                                    {% endif %}
                                </td>

                                <td>
                                    {% if isOwner %}
                                        <span class="badge bg-success">My Product</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Shared / Read Only</span>
                                    {% endif %}
                                </td>

                                <td style="min-width: 220px;">

                                    {% if isOwner %}

                                        <a href="{{ path('staff_products_edit', {id: product.id}) }}"
                                           class="btn btn-primary btn-sm mb-2">
                                            Edit
                                        </a>

                                        <form method="POST"
                                              action="{{ path('staff_products_delete', {id: product.id}) }}"
                                              onsubmit="return confirm('Are you sure you want to delete this product?');">

                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('delete_staff_product_' ~ product.id) }}">

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm mb-2">
                                                Delete
                                            </button>
                                        </form>

                                        <hr>

                                        <form method="POST"
                                              action="{{ path('staff_product_stock_update', {id: product.id}) }}">

                                            <input
                                                type="number"
                                                name="quantity"
                                                min="1"
                                                required
                                                class="form-control form-control-sm mb-2"
                                                placeholder="Enter quantity"
                                            >

                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('update-stock-' ~ product.id) }}"
                                            >

                                            <div class="d-flex gap-2">
                                                <button type="submit"
                                                        name="operation"
                                                        value="add"
                                                        class="btn btn-success btn-sm">
                                                    + Add
                                                </button>

                                                <button type="submit"
                                                        name="operation"
                                                        value="remove"
                                                        class="btn btn-danger btn-sm">
                                                    - Remove
                                                </button>
                                            </div>

                                        </form>

                                    {% else %}

                                        <span class="text-muted small">
                                            You can view this product but cannot edit it.
                                        </span>

                                    {% endif %}

                                </td>

                            </tr>

                        {% else %}

                            <tr>
                                <td colspan="8" class="text-center text-muted">
                                    No products available.
                                </td>
                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

            <div class="mt-3">
                <a href="{{ path('app_staff') }}" class="btn btn-secondary">
                    Back to Dashboard
                </a>
            </div>

        </div>

    </main>

</div>

{% endblock %}
