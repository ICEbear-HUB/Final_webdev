
{% extends 'base.html.twig' %}

{% block title %}My Profile | Aceplus{% endblock %}

{% block body %}

<div class="admin-layout">

    <aside class="sidebar">
        <div class="sidebar-header">
            <h2>Aceplus</h2>
            <p>Staff Panel</p>
        </div>

        <nav>
            <ul>
                <li>
                    <a href="{{ path('app_staff') }}">Dashboard</a>
                </li>
                <li>
                    <a href="{{ path('staff_products') }}">Products</a>
                </li>
                <li>
                    <a href="{{ path('staff_profile') }}">My Profile</a>
                </li>
                <li>
                    <a href="{{ path('app_logout') }}">Logout</a>
                </li>
            </ul>
        </nav>
    </aside>

    <main class="main-content">

        <div class="page-header">
            <h1>My Profile</h1>
            <p>View and update your personal information.</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        <div class="card p-4">

            <h3>Account Information</h3>

            <p>
                <strong>Email:</strong>
                {{ user.email }}
            </p>

            <p>
                <strong>Account Role:</strong>
                Staff
            </p>

            <hr>

            <h3>Edit Personal Information</h3>

            {{ form_start(form) }}

                {{ form_row(form.firstName) }}
                {{ form_row(form.lastName) }}
                {{ form_row(form.phone) }}
                {{ form_row(form.address) }}

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a href="{{ path('app_staff') }}" class="btn btn-secondary">
                    Back to Dashboard
                </a>

            {{ form_end(form) }}

        </div>

    </main>

</div>

{% endblock %}
