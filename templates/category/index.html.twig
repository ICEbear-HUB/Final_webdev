
{% extends 'base.html.twig' %}

{% block title %}Manage Categories | Aceplus{% endblock %}

{% block body %}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Category Management</h1>
            <p class="text-muted">Manage your Aceplus product categories.</p>
        </div>

        <a href="{{ path('admin_categories_new') }}" class="btn btn-success">
            + Add New Category
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Category Name</th>
                        <th>Products</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for category in categories %}
                        <tr>
                            <td>{{ category.id }}</td>

                            <td>{{ category.Name }}</td>

                            <td>{{ category.products|length }}</td>

                            <td>
                                <a href="{{ path('admin_categories_show', {'id': category.id}) }}"
                                   class="btn btn-sm btn-info">
                                    View
                                </a>

                                <a href="{{ path('admin_categories_edit', {'id': category.id}) }}"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>
                            </td>
                        </tr>

                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                No categories found. Add your first category!
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>

            </table>

        </div>
    </div>

    <a href="{{ path('app_admin') }}" class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>

{% endblock %}
