
{% extends 'base.html.twig' %}

{% block title %}Category Details | Aceplus{% endblock %}

{% block body %}

<div class="container-fluid mt-4">

    <div class="mb-4">
        <h1>Category Details</h1>
        <p class="text-muted">
            View information about this product category.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Category Information</h5>
        </div>

        <div class="card-body">

            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th style="width: 200px;">Category ID</th>
                        <td>{{ category.id }}</td>
                    </tr>

                    <tr>
                        <th>Category Name</th>
                        <td>{{ category.Name }}</td>
                    </tr>

                    <tr>
                        <th>Total Products</th>
                        <td>{{ category.products|length }}</td>
                    </tr>
                </tbody>
            </table>

            <div class="d-flex gap-2 mt-3">

                <a href="{{ path('admin_categories_index') }}"
                   class="btn btn-secondary">
                    Back to Categories
                </a>

                <a href="{{ path('admin_categories_edit', {'id': category.id}) }}"
                   class="btn btn-warning">
                    Edit Category
                </a>

            </div>

        </div>
    </div>

</div>

{% endblock %}
