
{% extends 'base.html.twig' %}

{% block title %}Add New Category | Aceplus{% endblock %}

{% block body %}

<div class="container-fluid mt-4">

    <div class="mb-4">
        <h1>Add New Category</h1>
        <p class="text-muted">
            Create a new category for your Aceplus products.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            {{ include('category/_form.html.twig') }}

            <a href="{{ path('admin_categories_index') }}"
               class="btn btn-secondary mt-3">
                Back to Categories
            </a>

        </div>
    </div>

</div>

{% endblock %}
