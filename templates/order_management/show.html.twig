
{% extends 'base.html.twig' %}

{% block title %}Order Details | Aceplus{% endblock %}

{% block body %}

<div class="main-content">

    <div class="page-header">
        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            <a href="{{ path('manage_orders_index') }}"
               class="btn btn-secondary btn-sm">
                <i class="bi bi-arrow-left"></i>
                Back to Orders
            </a>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin') }}"
                   class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-speedometer2"></i>
                    Back to Dashboard
                </a>
            {% elseif is_granted('ROLE_STAFF') %}
                <a href="{{ path('app_staff') }}"
                   class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-speedometer2"></i>
                    Back to Dashboard
                </a>
            {% endif %}
        </div>

        <h1>Order Details</h1>
        <p>Review customer information and update the order status.</p>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card p-4 mb-4">

                <h5 class="mb-4">Order Information</h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <small class="text-muted">Order Number</small>
                        <h6>{{ order.orderNumber }}</h6>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted">Order Date</small>
                        <h6>
                            {{ order.createdAt|date('M d, Y - h:i A') }}
                        </h6>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted">Customer Email</small>
                        <h6>{{ order.user.email }}</h6>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted">Payment Method</small>
                        <h6>{{ order.paymentMethod|default('Cash on Delivery (COD)') }}</h6>
                    </div>

                </div>

            </div>

            <div class="card p-4 mb-4">

                <h5 class="mb-4">Purchased Products</h5>

                <div class="table-responsive">

                    <table class="table">

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>

                        <tbody>

                            {% for item in order.items %}

                                <tr>
                                    <td>{{ item.product.name }}</td>

                                    <td>
                                        ₱{{ item.price|number_format(2) }}
                                    </td>

                                    <td>{{ item.quantity }}</td>

                                    <td>
                                        ₱{{ (item.price * item.quantity)|number_format(2) }}
                                    </td>
                                </tr>

                            {% endfor %}

                        </tbody>

                    </table>

                </div>

                <div class="text-end mt-3">
                    <h5>
                        Total Amount:
                        <span style="color: #a3e635;">
                            ₱{{ order.totalAmount|number_format(2) }}
                        </span>
                    </h5>
                </div>

            </div>

            <div class="card p-4">

                <h5 class="mb-4">Delivery Information</h5>

                <div class="mb-3">
                    <small class="text-muted">Delivery Address</small>
                    <p class="mb-0">{{ order.deliveryAddress }}</p>
                </div>

                <div>
                    <small class="text-muted">Phone Number</small>
                    <p class="mb-0">{{ order.phone }}</p>
                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card p-4">

                <h5 class="mb-3">Order Status Progression</h5>

                <div class="mb-3">
                    <small class="text-muted d-block mb-1">Current Status</small>
                    {% if order.status == 'Pending' %}
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                            <i class="bi bi-clock-history me-1"></i> Pending
                        </span>
                    {% elseif order.status == 'Processing' %}
                        <span class="badge bg-info text-dark fs-6 px-3 py-2">
                            <i class="bi bi-arrow-repeat me-1"></i> Processing
                        </span>
                    {% elseif order.status == 'Completed' %}
                        <span class="badge bg-success fs-6 px-3 py-2">
                            <i class="bi bi-check-circle-fill me-1"></i> Completed
                        </span>
                    {% elseif order.status == 'Cancelled' %}
                        <span class="badge bg-danger fs-6 px-3 py-2">
                            <i class="bi bi-x-circle-fill me-1"></i> Cancelled
                        </span>
                    {% else %}
                        <span class="badge bg-secondary fs-6 px-3 py-2">
                            {{ order.status }}
                        </span>
                    {% endif %}
                </div>

                {# ONE-WAY FLOW VISUALIZER #}
                <div class="mb-4 p-3 rounded" style="background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border);">
                    <small class="text-muted d-block fw-semibold mb-2">Workflow Progression:</small>
                    <div class="d-flex align-items-center gap-2 flex-wrap small">
                        <span class="badge {% if order.status == 'Pending' %}bg-warning text-dark{% elseif order.status in ['Processing', 'Completed'] %}bg-secondary text-light{% else %}bg-dark border border-secondary text-muted{% endif %}">
                            1. Pending
                        </span>
                        <i class="bi bi-arrow-right text-muted"></i>
                        <span class="badge {% if order.status == 'Processing' %}bg-info text-dark{% elseif order.status == 'Completed' %}bg-secondary text-light{% else %}bg-dark border border-secondary text-muted{% endif %}">
                            2. Processing
                        </span>
                        <i class="bi bi-arrow-right text-muted"></i>
                        <span class="badge {% if order.status == 'Completed' %}bg-success text-white{% else %}bg-dark border border-secondary text-muted{% endif %}">
                            3. Completed
                        </span>
                    </div>
                    {% if order.status == 'Cancelled' %}
                        <div class="mt-2 text-danger small">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> This order was cancelled.
                        </div>
                    {% endif %}
                </div>

                {% if order.isFinalStatus %}
                    <div class="alert alert-secondary mb-0">
                        <i class="bi bi-lock-fill me-1"></i>
                        This order is marked as <strong>{{ order.status }}</strong> and cannot be modified further. Status changes are permanently locked.
                    </div>
                {% else %}
                    <form method="POST"
                          action="{{ path('manage_orders_update_status', {
                              id: order.id
                          }) }}">

                        <input type="hidden"
                               name="_token"
                               value="{{ csrf_token('update-order-status-' ~ order.id) }}">

                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="status">
                                Advance Status to:
                            </label>

                            <select name="status"
                                    id="status"
                                    class="form-select"
                                    required>
                                <option value="" disabled selected>-- Select Next Status --</option>
                                {% for nextStatus in nextStatuses %}
                                    <option value="{{ nextStatus }}">
                                        {{ nextStatus }}
                                    </option>
                                {% endfor %}
                            </select>
                            <div class="form-text text-muted">
                                <i class="bi bi-shield-check text-info me-1"></i>
                                One-way progression: reverting to previous statuses is disabled.
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold">
                            <i class="bi bi-arrow-right-circle me-1"></i>
                            Update Status
                        </button>

                    </form>
                {% endif %}

            </div>

        </div>

    </div>

</div>

{% endblock %}
