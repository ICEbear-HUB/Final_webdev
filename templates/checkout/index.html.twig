
{% extends 'base.html.twig' %}

{% block title %}Checkout | Aceplus{% endblock %}

{% block body %}

<style>
    .checkout-container {
        max-width: 1150px;
        margin: 45px auto;
        padding: 20px;
        color: #f9fafb;
    }

    .checkout-title {
        margin-bottom: 30px;
    }

    .checkout-title h1 {
        font-weight: 800;
    }

    .checkout-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 25px;
    }

    .checkout-card {
        background: #1f2937;
        border: 1px solid #374151;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 20px;
    }

    .checkout-card h3 {
        font-size: 20px;
        margin-bottom: 20px;
        font-weight: 700;
    }

    .checkout-form label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .checkout-form input,
    .checkout-form textarea {
        width: 100%;
        padding: 13px;
        margin-bottom: 20px;
        border-radius: 8px;
        border: 1px solid #4b5563;
        background: #111827;
        color: white;
    }

    .checkout-form textarea {
        min-height: 110px;
        resize: vertical;
    }

    .checkout-item {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 15px 0;
        border-bottom: 1px solid #374151;
    }

    .checkout-item:last-child {
        border-bottom: none;
    }

    .checkout-muted {
        color: #9ca3af;
        font-size: 14px;
    }

    .checkout-total {
        display: flex;
        justify-content: space-between;
        font-size: 21px;
        font-weight: 800;
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px solid #4b5563;
    }

    .checkout-total span:last-child {
        color: #a3e635;
    }

    .place-order-btn {
        display: block;
        width: 100%;
        padding: 15px;
        background: #a3e635;
        color: #111827;
        border: none;
        border-radius: 8px;
        font-weight: 800;
        font-size: 16px;
        cursor: pointer;
        margin-top: 20px;
    }

    .place-order-btn:hover {
        background: #84cc16;
    }

    .back-cart {
        display: inline-block;
        color: #a3e635;
        text-decoration: none;
        margin-bottom: 20px;
    }

    .payment-options {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 22px;
    }

    .payment-option-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        background: #111827;
        border: 2px solid #374151;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .payment-option-card:hover {
        border-color: #6b7280;
    }

    .payment-option-card.active {
        border-color: #a3e635;
        background: rgba(163, 230, 53, 0.08);
    }

    .payment-option-card input[type="radio"] {
        width: 18px;
        height: 18px;
        margin: 0;
        accent-color: #a3e635;
        cursor: pointer;
    }

    .payment-option-info {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .payment-option-title {
        font-weight: 700;
        font-size: 15px;
        color: #f9fafb;
    }

    .payment-option-desc {
        font-size: 12px;
        color: #9ca3af;
    }

    .payment-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-cod {
        background: rgba(163, 230, 53, 0.2);
        color: #a3e635;
    }

    .badge-gcash {
        background: rgba(0, 122, 255, 0.2);
        color: #38bdf8;
    }

    .badge-maya {
        background: rgba(20, 184, 166, 0.2);
        color: #2dd4bf;
    }

    @media (max-width: 768px) {
        .checkout-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="checkout-container">

    <a href="{{ path('cart_index') }}" class="back-cart">
        ← Back to Cart
    </a>

    <div class="checkout-title">
        <h1>Checkout</h1>
        <p class="checkout-muted">
            Complete your delivery information to place your order.
        </p>
    </div>

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="checkout-grid">

        <div class="checkout-card">

            <h3>Delivery Information</h3>

            <form method="POST" action="{{ path('checkout_index') }}" class="checkout-form">

                <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token('checkout') }}"
                >

                <label for="deliveryAddress">Delivery Address</label>

                <textarea
                    id="deliveryAddress"
                    name="deliveryAddress"
                    placeholder="Enter your complete delivery address"
                    required
                >{{ defaultAddress }}</textarea>

                <label for="phone">Phone Number</label>

                <input
                    type="tel"
                    id="phone"
                    name="phone"
                    value="{{ defaultPhone }}"
                    placeholder="Enter your phone number"
                    maxlength="20"
                    required
                >

                <label class="mb-2">Payment Method</label>

                <div class="payment-options">

                    <label class="payment-option-card active" for="pay_cod">
                        <input
                            type="radio"
                            id="pay_cod"
                            name="paymentMethod"
                            value="Cash on Delivery (COD)"
                            checked
                            onchange="updatePaymentSelection(this)"
                        >
                        <div class="payment-option-info">
                            <span class="payment-option-title">
                                <i class="bi bi-cash-stack me-1"></i> Cash on Delivery (COD)
                            </span>
                            <span class="payment-option-desc">Pay with cash upon receipt of order</span>
                        </div>
                        <span class="payment-badge badge-cod">COD</span>
                    </label>

                    <label class="payment-option-card" for="pay_gcash">
                        <input
                            type="radio"
                            id="pay_gcash"
                            name="paymentMethod"
                            value="GCash"
                            onchange="updatePaymentSelection(this)"
                        >
                        <div class="payment-option-info">
                            <span class="payment-option-title">
                                <i class="bi bi-wallet2 me-1"></i> GCash
                            </span>
                            <span class="payment-option-desc">Pay seamlessly via your GCash e-wallet</span>
                        </div>
                        <span class="payment-badge badge-gcash">GCash</span>
                    </label>

                    <label class="payment-option-card" for="pay_maya">
                        <input
                            type="radio"
                            id="pay_maya"
                            name="paymentMethod"
                            value="Maya"
                            onchange="updatePaymentSelection(this)"
                        >
                        <div class="payment-option-info">
                            <span class="payment-option-title">
                                <i class="bi bi-credit-card-2-front me-1"></i> Maya
                            </span>
                            <span class="payment-option-desc">Pay via Maya app or linked Maya card</span>
                        </div>
                        <span class="payment-badge badge-maya">Maya</span>
                    </label>

                </div>

                <button type="submit" class="place-order-btn">
                    Place Order
                </button>

            </form>

        </div>

        <div class="checkout-card">

            <h3>Order Summary</h3>

            {% for item in cartItems %}

                <div class="checkout-item">

                    <div>
                        <strong>{{ item.product.Name }}</strong>

                        <div class="checkout-muted">
                            Quantity: {{ item.quantity }}
                        </div>

                        <div class="checkout-muted">
                            ₱{{ item.product.price|number_format(2, '.', ',') }}
                            each
                        </div>
                    </div>

                    <strong>
                        ₱{{ item.subtotal|number_format(2, '.', ',') }}
                    </strong>

                </div>

            {% endfor %}

            <div class="checkout-total">
                <span>Total</span>

                <span>
                    ₱{{ total|number_format(2, '.', ',') }}
                </span>
            </div>

            <p class="checkout-muted" style="margin-top: 15px;" id="summaryPaymentMethod">
                Payment method: <strong>Cash on Delivery (COD)</strong>
            </p>

        </div>

    </div>

</div>

<script>
    function updatePaymentSelection(radio) {
        document.querySelectorAll('.payment-option-card').forEach(card => card.classList.remove('active'));
        if (radio.checked) {
            radio.closest('.payment-option-card').classList.add('active');
            const summaryMethod = document.getElementById('summaryPaymentMethod');
            if (summaryMethod) {
                summaryMethod.innerHTML = 'Payment method: <strong>' + radio.value + '</strong>';
            }
        }
    }
</script>

{% endblock %}
