
{% extends 'base.html.twig' %}

{% block title %}Shopping Cart | Aceplus{% endblock %}

{% block body %}

<style>
    .cart-page {
        min-height: 100vh;
        background: #111827;
        color: #f9fafb;
        padding: 45px 6%;
    }

    .cart-title {
        font-weight: 800;
        margin-bottom: 8px;
    }

    .cart-subtitle {
        color: #9ca3af;
        margin-bottom: 30px;
    }

    .cart-card {
        background: #1f2937;
        border: 1px solid #374151;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 18px;
    }

    .cart-product-name {
        font-weight: 700;
        font-size: 18px;
    }

    .cart-price {
        color: #a3e635;
        font-weight: 800;
    }

    .cart-total {
        background: #1f2937;
        border: 1px solid #374151;
        border-radius: 14px;
        padding: 25px;
        position: sticky;
        top: 20px;
    }

    .total-amount {
        color: #a3e635;
        font-size: 28px;
        font-weight: 800;
    }

    .quantity-input {
        max-width: 100px;
        background: #111827;
        color: white;
        border: 1px solid #374151;
    }

    .quantity-input:focus {
        background: #111827;
        color: white;
        border-color: #a3e635;
        box-shadow: none;
    }

    .btn-aceplus {
        background: #a3e635;
        color: #111827;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        padding: 11px 18px;
    }

    .btn-aceplus:hover {
        background: #84cc16;
        color: #111827;
    }

    .empty-cart {
        background: #1f2937;
        border: 1px solid #374151;
        border-radius: 14px;
        padding: 65px 20px;
        text-align: center;
    }

    .empty-cart i {
        font-size: 55px;
        color: #a3e635;
    }
</style>

<div class="cart-page">

    <div class="container-fluid">

        {# HEADER #}
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

            <div>
                <h1 class="cart-title">
                    My Shopping Cart
                </h1>

                <p class="cart-subtitle">
                    Review and manage your selected products.
                </p>
            </div>

            <a href="{{ path('app_home') }}" class="btn btn-outline-light">
                <i class="bi bi-arrow-left"></i>
                Continue Shopping
            </a>

        </div>

        {# FLASH MESSAGES #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}

        {% if cartItems is not empty %}

            <div class="row g-4">

                {# CART ITEMS #}
                <div class="col-lg-8">

                    {% for item in cartItems %}

                        <div class="cart-card">

                            <div class="row align-items-center g-3">

                                <div class="col-md-3">

                                    {% if item.product.image %}

                                        {% set itemImg = item.product.image %}
                                        {% if not (itemImg starts with 'uploads/') and not (itemImg starts with 'images/') and not (itemImg starts with 'http') %}
                                            {% set itemImg = 'images/' ~ itemImg %}
                                        {% endif %}

                                        <img
                                            src="{{ asset(itemImg) }}"
                                            alt="{{ item.product.Name }}"
                                            class="img-fluid rounded"
                                            style="width: 100%; height: 130px; object-fit: contain; background: #05090b; padding: 6px;"
                                        >

                                    {% else %}

                                        <div class="bg-secondary rounded d-flex align-items-center justify-content-center"
                                             style="height: 130px;">

                                            <i class="bi bi-cup-straw fs-1"></i>

                                        </div>

                                    {% endif %}

                                </div>

                                <div class="col-md-5">

                                    <h5 class="cart-product-name">
                                        {{ item.product.Name }}
                                    </h5>

                                    <p class="text-secondary mb-2">
                                        ₱{{ item.product.price|number_format(2, '.', ',') }}
                                        each
                                    </p>

                                    <p class="text-success small mb-0">
                                        Available Stock: {{ item.product.stock }}
                                    </p>

                                </div>

                                <div class="col-md-4">

                                    <div class="mb-3">

                                        <span class="text-secondary small">
                                            Subtotal
                                        </span>

                                        <div class="cart-price">
                                            ₱{{ item.subtotal|number_format(2, '.', ',') }}
                                        </div>

                                    </div>

                                    {# UPDATE QUANTITY #}
                                    <form
                                        method="POST"
                                        action="{{ path('cart_update', {id: item.product.id}) }}"
                                        class="d-flex gap-2 mb-2"
                                    >

                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('cart_update_' ~ item.product.id) }}"
                                        >

                                        <input
                                            type="number"
                                            name="quantity"
                                            class="form-control quantity-input"
                                            min="1"
                                            max="{{ item.product.stock }}"
                                            value="{{ item.quantity }}"
                                            required
                                        >

                                        <button
                                            type="submit"
                                            class="btn btn-outline-success btn-sm"
                                        >
                                            Update
                                        </button>

                                    </form>

                                    {# REMOVE ITEM #}
                                    <form
                                        method="POST"
                                        action="{{ path('cart_remove', {id: item.product.id}) }}"
                                    >

                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('cart_remove_' ~ item.product.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="btn btn-outline-danger btn-sm w-100"
                                        >
                                            <i class="bi bi-trash"></i>
                                            Remove
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    {% endfor %}

                </div>

                {# ORDER SUMMARY #}
                <div class="col-lg-4">

                    <div class="cart-total">

                        <h4 class="fw-bold mb-4">
                            Order Summary
                        </h4>

                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-secondary">
                                Items
                            </span>

                            <span>
                                {{ cartItems|length }}
                            </span>

                        </div>

                        <hr class="border-secondary">

                        <div class="d-flex justify-content-between align-items-center">

                            <strong>Total</strong>

                            <span class="total-amount">
                                ₱{{ total|number_format(2, '.', ',') }}
                            </span>

                        </div>

                        {% if app.user %}
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                                <div class="alert alert-warning small mt-4 mb-0">
                                    <i class="bi bi-info-circle me-1"></i> Admin &amp; Staff accounts cannot place customer orders.
                                </div>
                            {% else %}
                                <a href="{{ path('checkout_index') }}" class="btn btn-aceplus w-100 mt-4 d-flex justify-content-center align-items-center gap-2">
                                    <span>Proceed to Checkout</span>
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            {% endif %}
                        {% else %}
                            <a href="{{ path('app_login') }}" class="btn btn-aceplus w-100 mt-4 d-flex justify-content-center align-items-center gap-2">
                                <span>Login to Checkout</span>
                                <i class="bi bi-box-arrow-in-right"></i>
                            </a>
                            <p class="text-secondary small text-center mt-2 mb-0">
                                Please sign in to complete your purchase.
                            </p>
                        {% endif %}

                    </div>

                </div>

            </div>

        {% else %}

            {# EMPTY CART #}
            <div class="empty-cart">

                <i class="bi bi-cart-x"></i>

                <h3 class="fw-bold mt-3">
                    Your Cart is Empty
                </h3>

                <p class="text-secondary">
                    You haven't added any products to your shopping cart yet.
                </p>

                <a href="{{ path('app_home') }}" class="btn btn-aceplus mt-3">
                    Explore Products
                </a>

            </div>

        {% endif %}

    </div>

</div>

{% endblock %}
