
{% extends 'base.html.twig' %}

{% block title %}Aceplus Inventory Management{% endblock %}

{% block body %}

<div class="admin-layout">

    {% include 'partials/sidebar.html.twig' %}

    <main class="admin-content">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h1 class="mb-1">Inventory Management</h1>
                <p class="text-muted mb-0">
                    Monitor and manage Aceplus product stock.
                </p>
            </div>

            <a href="{{ path('admin_inventory_history') }}"
               class="btn btn-outline-primary">
                <i class="bi bi-clock-history"></i>
                Stock Movement History
            </a>
        </div>

        {# FLASH MESSAGES #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {# INVENTORY STATISTICS #}
        <div class="row">

            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card shadow p-3 h-100">
                    <h6>Total Products</h6>
                    <h2>{{ totalProducts }}</h2>
                    <small class="text-muted">Registered products</small>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card shadow p-3 h-100">
                    <h6>Total Stock Units</h6>
                    <h2 class="text-primary">
                        {{ totalStock|number_format }}
                    </h2>
                    <small class="text-muted">Combined available units</small>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card shadow p-3 h-100">
                    <h6>Low Stock</h6>
                    <h2 class="text-warning">{{ lowStockCount }}</h2>
                    <small class="text-muted">
                        1 to {{ lowStockThreshold }} units remaining
                    </small>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card shadow p-3 h-100">
                    <h6>Out of Stock</h6>
                    <h2 class="text-danger">{{ outOfStockCount }}</h2>
                    <small class="text-muted">Products with no available stock</small>
                </div>
            </div>

        </div>

        {# LOW STOCK ALERT #}
        {% if lowStockCount > 0 or outOfStockCount > 0 %}
            <div class="alert alert-warning mt-3">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>Inventory Alert:</strong>
                You have {{ lowStockCount }} low-stock product(s)
                and {{ outOfStockCount }} out-of-stock product(s).
            </div>
        {% else %}
            <div class="alert alert-success mt-3">
                <i class="bi bi-check-circle"></i>
                All products have sufficient stock.
            </div>
        {% endif %}

        {# PRODUCT INVENTORY TABLE #}
        <div class="card shadow mt-4 mb-4">

            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0">
                    <i class="bi bi-box-seam"></i>
                    Product Inventory
                </h5>

                <span class="badge bg-primary">
                    {{ totalProducts }} Products
                </span>
            </div>

            <div class="card-body">

                {% if products is empty %}

                    <div class="alert alert-info mb-0">
                        No products have been added yet.
                    </div>

                {% else %}

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Current Stock</th>
                                    <th>Status</th>
                                    <th style="min-width: 320px;">Stock Adjustment</th>
                                </tr>
                            </thead>

                            <tbody>

                                {% for product in products %}

                                    <tr>
                                        <td>
                                            <strong>{{ product.name }}</strong>
                                            <div class="small text-muted">
                                                Product #{{ product.id }}
                                            </div>
                                        </td>

                                        <td>
                                            {{ product.category
                                                ? product.category.name
                                                : 'Uncategorized' }}
                                        </td>

                                        <td>
                                            <strong>{{ product.stock }}</strong>
                                            <small class="text-muted">units</small>
                                        </td>

                                        <td>
                                            {% if product.stock <= 0 %}
                                                <span class="badge bg-danger">
                                                    Out of Stock
                                                </span>
                                            {% elseif product.stock <= lowStockThreshold %}
                                                <span class="badge bg-warning text-dark">
                                                    Low Stock
                                                </span>
                                            {% else %}
                                                <span class="badge bg-success">
                                                    In Stock
                                                </span>
                                            {% endif %}
                                        </td>

                                        <td>
                                            <form method="post"
                                                  action="{{ path('admin_inventory_stock_update', {id: product.id}) }}">

                                                <input type="hidden"
                                                       name="_token"
                                                       value="{{ csrf_token('admin_stock_' ~ product.id) }}">

                                                <div class="input-group input-group-sm mb-2">

                                                    <input type="number"
                                                           name="quantity"
                                                           class="form-control"
                                                           min="1"
                                                           step="1"
                                                           placeholder="Quantity"
                                                           required>

                                                    <button type="submit"
                                                            name="operation"
                                                            value="add"
                                                            class="btn btn-success">
                                                        <i class="bi bi-plus-circle"></i>
                                                        Add
                                                    </button>

                                                    <button type="submit"
                                                            name="operation"
                                                            value="remove"
                                                            class="btn btn-danger"
                                                            {% if product.stock <= 0 %}disabled{% endif %}>
                                                        <i class="bi bi-dash-circle"></i>
                                                        Remove
                                                    </button>

                                                </div>

                                                <input type="text"
                                                       name="note"
                                                       class="form-control form-control-sm"
                                                       maxlength="500"
                                                       placeholder="Reason for adjustment (optional)">

                                            </form>
                                        </td>

                                    </tr>

                                {% endfor %}

                            </tbody>

                        </table>
                    </div>

                {% endif %}

            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('admin_products_index') }}"
               class="btn btn-outline-primary">
                <i class="bi bi-box"></i>
                Manage Products
            </a>

            <a href="{{ path('admin_inventory_history') }}"
               class="btn btn-primary">
                <i class="bi bi-clock-history"></i>
                View Stock History
            </a>
        </div>

    </main>
</div>

{% endblock %}
