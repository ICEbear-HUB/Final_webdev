{{ form_start(form, {'attr': {'class': 'card shadow p-4 mt-4'}}) }}

    {{ form_errors(form) }}

    <div class="mb-3">
        {{ form_label(form.email, 'Email Address', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Enter email address'}}) }}
        {{ form_errors(form.email) }}
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_label(form.firstName, 'First Name', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'First name'}}) }}
            {{ form_errors(form.firstName) }}
        </div>

        <div class="col-md-6 mb-3">
            {{ form_label(form.lastName, 'Last Name', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Last name'}}) }}
            {{ form_errors(form.lastName) }}
        </div>
    </div>

    <div class="mb-3">
        {{ form_label(form.plainPassword, 'Password', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.plainPassword) }}
        <small class="text-muted">Minimum 8 characters. Leave blank when editing to keep the current password.</small>
    </div>

    <div class="mb-3">
        {{ form_label(form.accountRole, 'Account Role', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.accountRole, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.accountRole) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.phone, 'Phone Number', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.phone, {'attr': {'class': 'form-control', 'placeholder': 'Phone number'}}) }}
        {{ form_errors(form.phone) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.address, 'Address', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.address, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Address'}}) }}
        {{ form_errors(form.address) }}
    </div>

    <div class="form-check mb-4">
        {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
        {{ form_label(form.isActive, 'Active Account', {'label_attr': {'class': 'form-check-label'}}) }}
        {{ form_errors(form.isActive) }}
    </div>

    <div>
        <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
        <a href="{{ path('admin_users') }}" class="btn btn-secondary">Cancel</a>
    </div>

{{ form_end(form) }}
